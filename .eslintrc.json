{
    "env": {
        "node": true,
        "es6": true
    },
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "extends": [
        "eslint:recommended"
    ],
    "overrides": [
        {
            "files": ["*.ts", "*.tsx"],
            "extends": [
                "plugin:@typescript-eslint/recommended-type-checked"
            ],
            "parserOptions": {
                "project":  ["./tsconfig.json"]
            }
        }
    ]
}
